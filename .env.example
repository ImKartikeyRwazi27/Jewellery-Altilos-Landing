# Copy to .env and fill in. NEVER commit a filled-in .env — only this template.
# Every value below is a placeholder; none of them are real.
#
# "Required" means the app throws on first access if it is missing (see
# src/lib/env.ts). "Optional" means the feature degrades rather than failing.
#
# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Postgres (Neon). Used by Prisma at runtime and by `prisma migrate`.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Absolute origin, no trailing slash. Used to build onboarding links that are
# emailed to customers, and for canonical URLs — a wrong value sends buyers to
# the wrong host.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Stripe secret key. Test keys start sk_test_, live keys sk_live_.
STRIPE_SECRET_KEY="sk_test_xxx"

# Signing secret for the /api/stripe/webhook endpoint. Distinct per endpoint —
# the value from `stripe listen` is NOT the value from the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# One Stripe PRODUCT per plan. Checkout resolves each product's default price at
# session creation, so repricing a plan means changing its default price in
# Stripe, not editing anything here.
STRIPE_PRODUCT_ID_PULSE="prod_xxx"
STRIPE_PRODUCT_ID_CORE="prod_xxx"
STRIPE_PRODUCT_ID_CORE_PLUS="prod_xxx"
STRIPE_PRODUCT_ID_EXPERT="prod_xxx"

# Pepper for hashing onboarding access tokens. Any long random string; changing
# it invalidates every onboarding link already sent.
ONBOARDING_TOKEN_PEPPER="change-me-to-a-long-random-string"

# Mailchimp Transactional (Mandrill) — the post-payment onboarding email.
MAILCHIMP_TRANSACTIONAL_API_KEY="md-xxx"
MAILCHIMP_TRANSACTIONAL_FROM_EMAIL="hello@example.com"
MAILCHIMP_TRANSACTIONAL_FROM_NAME="Altilos"

# Resend — the lead-magnet report email.
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="hello@example.com"
RESEND_FROM_NAME="Altilos"

# ---------------------------------------------------------------------------
# Optional — checkout add-ons
# ---------------------------------------------------------------------------

# A JSON object mapping add-on slug -> Stripe PRICE id (not a product id).
#
# Unset is a legitimate state: no add-ons are offered and the picker shows the
# plan alone. A PARTIAL map is legitimate too — only the mapped add-ons are
# shown. Both are safe because CheckoutGateway renders the intersection of the
# catalog and this map, so nothing appears in a customer's total that the
# Checkout Session would not bill for.
#
# Rules enforced by src/lib/addon-price-map.ts (which never throws — it drops
# bad entries and warns):
#   - values must be `price_...` ids; `prod_...` is rejected
#   - every add-on needs its OWN distinct price, because reconciliation maps
#     price id -> slug in reverse; a price id reused across two slugs drops both
#   - unknown slugs are ignored with a warning
#
# Run `npm run verify:stripe` to check every id against Stripe: it reports the
# currency and amount of each price and lists which add-ons are unconfigured.
#
# The catalog lives in src/lib/addon-catalog.ts. All 18 slugs, by plan
# (Expert has no add-ons by design — everything is included in the plan):
#   pulse (6):
#     pulse.responses_50
#     pulse.competitor_2
#     pulse.expert_call_30
#     pulse.city_2
#     pulse.receipt_images
#     pulse.priority_3day
#   core (6):
#     core.responses_100
#     core.competitors_4
#     core.expert_call_45
#     core.city_3
#     core.receipt_images
#     core.priority_3day
#   core+ (6):
#     core_plus.responses_150
#     core_plus.expert_session_2
#     core_plus.smartoffers_pilot
#     core_plus.city_extra
#     core_plus.competitors_highcap
#     core_plus.priority_3day
#   expert (0):
#
# Full template, all 18 slugs (must be a single line):
STRIPE_ADDON_PRICE_IDS='{"pulse.responses_50":"price_xxx","pulse.competitor_2":"price_xxx","pulse.expert_call_30":"price_xxx","pulse.city_2":"price_xxx","pulse.receipt_images":"price_xxx","pulse.priority_3day":"price_xxx","core.responses_100":"price_xxx","core.competitors_4":"price_xxx","core.expert_call_45":"price_xxx","core.city_3":"price_xxx","core.receipt_images":"price_xxx","core.priority_3day":"price_xxx","core_plus.responses_150":"price_xxx","core_plus.expert_session_2":"price_xxx","core_plus.smartoffers_pilot":"price_xxx","core_plus.city_extra":"price_xxx","core_plus.competitors_highcap":"price_xxx","core_plus.priority_3day":"price_xxx"}'

# ---------------------------------------------------------------------------
# Optional — Stripe checkout branding
# ---------------------------------------------------------------------------

# Stripe File ids (upload with purpose `business_logo` / `business_icon`).
# The Stripe account belongs to Rwazi, so without these the hosted checkout page
# shows the Rwazi mark instead of Altilos. Only accepted because the session is
# `hosted_page`; Stripe rejects both in embedded mode.
STRIPE_BRAND_LOGO_FILE="file_xxx"
STRIPE_BRAND_ICON_FILE="file_xxx"

# ---------------------------------------------------------------------------
# Optional — Pipedrive CRM sync
# ---------------------------------------------------------------------------

# Without a token the CRM sync is skipped and the error is recorded on the row;
# payments and onboarding are unaffected.
PIPEDRIVE_API_TOKEN=""
# Defaults to https://api.pipedrive.com/api/v2 when unset.
PIPEDRIVE_API_BASE_URL=""
PIPEDRIVE_DEFAULT_OWNER_ID=""
PIPEDRIVE_LEAD_MAGNET_LABEL_ID=""

# Custom-field keys — the 40-char hashes from Pipedrive, not the field labels.
PIPEDRIVE_ONBOARDING_CONTEXT_FIELD_KEY=""
PIPEDRIVE_LEAD_COMPANY_FIELD_KEY=""
PIPEDRIVE_LEAD_SOURCE_FIELD_KEY=""
PIPEDRIVE_SECONDARY_LEAD_SOURCE_FIELD_KEY=""
PIPEDRIVE_LEAD_STATUS_FIELD_KEY=""
PIPEDRIVE_JOB_TITLE_FIELD_KEY=""
PIPEDRIVE_WEBSITE_FIELD_KEY=""

# ---------------------------------------------------------------------------
# Optional — internal notifications, lead magnet, SEO
# ---------------------------------------------------------------------------

# Where replies to Altilos emails go. Defaults to kartikey.sangal@rwazi.com.
RESEND_REPLY_TO_EMAIL="kartikey.sangal@rwazi.com"

# Comma-separated. Unset means nobody on the team is notified.
MAILCHIMP_TEAM_NOTIFICATION_EMAILS=""
RESEND_TEAM_NOTIFICATION_EMAILS=""

# The PDF sent by the email gate. Defaults shown; override only to change file.
LEAD_MAGNET_FILE_PATH="public/lead-magnet.pdf"
LEAD_MAGNET_FILE_NAME="Altilos-India-Jewellery-CLS-FY26.pdf"
LEAD_MAGNET_FILE_TYPE="application/pdf"

# Google Search Console verification token. Unset simply omits the meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
